{
  "version": 2,
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    },
    {
      "source": "/(.*)\\.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    }
  ],
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/BlogImg/(.*)",
      "dest": "/BlogImg/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/favicon.svg",
      "dest": "/favicon.svg"
    },
    {
      "src": "/favicon-(.*).png",
      "dest": "/favicon-$1.png"
    },
    {
      "src": "/android-chrome-(.*).png",
      "dest": "/android-chrome-$1.png"
    },
    {
      "src": "/apple-touch-icon.png",
      "dest": "/apple-touch-icon.png"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/site.webmanifest",
      "dest": "/site.webmanifest"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/googleed73e626632e7451.html",
      "dest": "/googleed73e626632e7451.html"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/calculators-sitemap.xml",
      "dest": "/calculators-sitemap.xml"
    },
    {
      "src": "/blog-sitemap.xml",
      "dest": "/blog-sitemap.xml"
    },
    {
      "src": "/logo-sitemap.xml",
      "dest": "/logo-sitemap.xml"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_API_URL": "https://weight-loss-final.onrender.com/api"
  }
} 